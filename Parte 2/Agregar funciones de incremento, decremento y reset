.include "m328pdef.inc"

.def temp     = r16
.def contador = r17
.def patron   = r18

.org 0x0000
    rjmp RESET

RESET:

    ; Stack
    ldi temp, HIGH(RAMEND)
    out SPH, temp

    ldi temp, LOW(RAMEND)
    out SPL, temp

    ; Configurar LEDs
    ldi temp, 0b00111111
    out DDRB, temp

    ldi temp, 0b00000001
    out DDRC, temp

    ; Configurar botones como entradas
    cbi DDRD, PD2
    cbi DDRD, PD3
    cbi DDRD, PD4

    ; Sin pull-ups
    cbi PORTD, PD2
    cbi PORTD, PD3
    cbi PORTD, PD4

    rjmp MAIN

MAIN:
    rjmp MAIN

; Contador inicia en 0
    ldi contador, 0

MAIN:

    in temp, PIND

    ; Si PD2 = 1 → incrementar
    sbrc temp, PD2
    rjmp INCREMENTAR

    in temp, PIND

    ; Si PD3 = 1 → decrementar
    sbrc temp, PD3
    rjmp DECREMENTAR

    in temp, PIND

    ; Si PD4 = 1 → reset
    sbrc temp, PD4
    rjmp RESET_CONTADOR

    rjmp MAIN

INCREMENTAR:

    inc contador

    cpi contador, 10
    brlo ESPERAR_D2

    ldi contador, 0

ESPERAR_D2:

    in temp, PIND
    sbrc temp, PD2
    rjmp ESPERAR_D2

    rjmp MAIN

DECREMENTAR:

    tst contador
    brne RESTAR

    ldi contador, 9
    rjmp ESPERAR_D3

RESTAR:

    dec contador

ESPERAR_D3:

    in temp, PIND
    sbrc temp, PD3
    rjmp ESPERAR_D3

    rjmp MAIN

RESET_CONTADOR:

    ldi contador, 0

ESPERAR_D4:

    in temp, PIND
    sbrc temp, PD4
    rjmp ESPERAR_D4

    rjmp MAIN
