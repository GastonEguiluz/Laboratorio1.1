.include "m328pdef.inc"

.def temp     = r16
.def contador = r17
.def patron   = r18

.org 0x0000
    rjmp RESET

RESET:

    ; Stack
    ldi temp, HIGH(RAMEND)
    out SPH, temp

    ldi temp, LOW(RAMEND)
    out SPL, temp

    ; Configurar LEDs
    ldi temp, 0b00111111
    out DDRB, temp

    ldi temp, 0b00000001
    out DDRC, temp

    ; Configurar botones como entradas
    cbi DDRD, PD2
    cbi DDRD, PD3
    cbi DDRD, PD4

    ; Sin pull-ups
    cbi PORTD, PD2
    cbi PORTD, PD3
    cbi PORTD, PD4

    rjmp MAIN

MAIN:
    rjmp MAIN
