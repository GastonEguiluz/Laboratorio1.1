.include "m328pdef.inc"

.def temp     = r16
.def contador = r17
.def patron   = r18

.org 0x0000
    rjmp RESET

RESET:

    ; Stack
    ldi temp, HIGH(RAMEND)
    out SPH, temp

    ldi temp, LOW(RAMEND)
    out SPL, temp

    ldi temp, 0b00111111
    out DDRB, temp

    ldi temp, 0b00000001
    out DDRC, temp
	
    cbi DDRD, PD2
    cbi DDRD, PD3
    cbi DDRD, PD4

    ; IMPORTANTE:
    ; NO activar pull-ups
    ; porque estamos usando Active HIGH

    cbi PORTD, PD2
    cbi PORTD, PD3
    cbi PORTD, PD4

    ; Contador inicia en 0
    ldi contador, 0

MAIN:

    rcall MOSTRAR

    in temp, PIND

    ; Si PD2 = 1 → presionado
    sbrc temp, PD2
    rjmp INCREMENTAR

    in temp, PIND

    ; Si PD3 = 1 → presionado
    sbrc temp, PD3
    rjmp DECREMENTAR

    in temp, PIND

    ; Si PD4 = 1 → presionado
    sbrc temp, PD4
    rjmp RESET_CONTADOR

    rjmp MAIN

INCREMENTAR:

    ; SUMAR 1
    inc contador

    ; Si llega a 10 → 0
    cpi contador, 10
    brlo ESPERAR_D2

    ldi contador, 0

ESPERAR_D2:

    in temp, PIND

    ; Mientras D2 esté en 1 seguimos esperando
    sbrc temp, PD2
    rjmp ESPERAR_D2

    rjmp MAIN

DECREMENTAR:

    ; Si contador = 0 → pasar a 9
    tst contador
    brne RESTAR

    ldi contador, 9
    rjmp ESPERAR_D3

RESTAR:

    ; RESTAR 1
    dec contador

ESPERAR_D3:

    in temp, PIND

    ; Mientras D3 esté en 1 seguimos esperando
    sbrc temp, PD3
    rjmp ESPERAR_D3

    rjmp MAIN

RESET_CONTADOR:

    ; Poner contador en 0
    ldi contador, 0

ESPERAR_D4:

    in temp, PIND

    ; Mientras D4 esté en 1 seguimos esperando
    sbrc temp, PD4
    rjmp ESPERAR_D4

    rjmp MAIN

MOSTRAR:

    cpi contador, 0
    breq MOSTRAR_0

    cpi contador, 1
    breq MOSTRAR_1

    cpi contador, 2
    breq MOSTRAR_2

    cpi contador, 3
    breq MOSTRAR_3

    cpi contador, 4
    breq MOSTRAR_4

    cpi contador, 5
    breq MOSTRAR_5

    cpi contador, 6
    breq MOSTRAR_6

    cpi contador, 7
    breq MOSTRAR_7

    cpi contador, 8
    breq MOSTRAR_8

    cpi contador, 9
    breq MOSTRAR_9

    ret

MOSTRAR_0:

    ldi patron, 0b00111111
    out PORTB, patron

    cbi PORTC, PC0

    ret

MOSTRAR_1:

    ldi patron, 0b00000110
    out PORTB, patron

    cbi PORTC, PC0

    ret

MOSTRAR_2:

    ldi patron, 0b00011011
    out PORTB, patron

    sbi PORTC, PC0

    ret

MOSTRAR_3:

    ldi patron, 0b00001111
    out PORTB, patron

    sbi PORTC, PC0

    ret

MOSTRAR_4:

    ldi patron, 0b00100110
    out PORTB, patron

    sbi PORTC, PC0

    ret

MOSTRAR_5:

    ldi patron, 0b00101101
    out PORTB, patron

    sbi PORTC, PC0

    ret

MOSTRAR_6:

    ldi patron, 0b00111101
    out PORTB, patron

    sbi PORTC, PC0

    ret

MOSTRAR_7:

    ldi patron, 0b00000111
    out PORTB, patron

    cbi PORTC, PC0

    ret

MOSTRAR_8:

    ldi patron, 0b00111111
    out PORTB, patron

    sbi PORTC, PC0

    ret

MOSTRAR_9:

    ldi patron, 0b00101111
    out PORTB, patron

    sbi PORTC, PC0

    ret
